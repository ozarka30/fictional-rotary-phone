[gd_resource type="Resource" script_class="DialogDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/dialog_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"hunter_intro"
speaker = "Hunter"
lines = PackedStringArray("Huh. Wasn't a shop here last time I passed through.", "You raise Hearthlings? Then let's see what you can do.", "Found this egg on the trail. Raise me a tracker: a good nose, and a bit of Tide in it.", "I'll be back in five days.")
